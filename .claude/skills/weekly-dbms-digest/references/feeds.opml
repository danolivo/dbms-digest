<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>DBMS Digest — input feeds</title>
    <!-- Curated RSS/Atom feeds scanned each run, across all languages.
         Verified 2026-06-20 (browser-confirmed where noted):
           [ok]      fetches as plain XML with a normal fetch.
           [browser] live feed, but our plain fetch returns empty/blocked - read it with the
                     Claude-in-Chrome browser tools. Do NOT drop these; the source is good,
                     only the plain-fetch path fails. (Lobsters confirmed live via browser.)
         Maintain like the other source lists: add confirmed feeds, retire only truly dead ones. -->
  </head>
  <body>
    <outline text="Aggregators (English)">
      <outline type="rss" text="Planet PostgreSQL [ok]" xmlUrl="https://planet.postgresql.org/rss20.xml"/>
      <outline type="rss" text="Hacker News - postgres (>=20 pts) [ok]" xmlUrl="https://hnrss.org/newest?q=postgres&amp;points=20"/>
      <outline type="rss" text="Hacker News - database (>=50 pts) [ok]" xmlUrl="https://hnrss.org/newest?q=database&amp;points=50"/>
      <outline type="rss" text="Lobsters - databases tag [browser - confirmed live]" xmlUrl="https://lobste.rs/t/databases.rss"/>
    </outline>
    <outline text="Community (browser - .rss blocklisted/empty for plain fetch)">
      <outline type="rss" text="r/PostgreSQL [browser]" xmlUrl="https://www.reddit.com/r/PostgreSQL/.rss"/>
      <outline type="rss" text="r/databasedevelopment [browser]" xmlUrl="https://www.reddit.com/r/databasedevelopment/.rss"/>
    </outline>
    <outline text="Research">
      <outline type="rss" text="arXiv cs.DB [ok]" xmlUrl="https://rss.arxiv.org/rss/cs.DB"/>
    </outline>
    <outline text="English blogs (added 2026-08-03)">
      <outline type="rss" text="Coroot blog [ok - browser-confirmed XML]" xmlUrl="https://coroot.com/feed/"/>
      <outline type="rss" text="Launch by Lunch (Sehrope Sarkuni) [ok - link-rel confirmed]" xmlUrl="https://launchbylunch.com/feeds/rss.xml"/>
    </outline>
    <outline text="English blogs (added 2026-09-14)">
      <!-- pganalyze's blog feed (pganalyze.com/blog/rss.xml) 404s as of 2026-09-14 and the
           "5mins of Postgres" series is confirmed ended - see sources.md. Not listed here. -->
      <outline type="rss" text="Valkey project blog" xmlUrl="https://valkey.io/atom.xml"/>
      <outline type="rss" text="PGXN dev log (David E. Wheeler)" xmlUrl="https://blog.pgxn.org/rss"/>
      <!-- tigerdata.com: /blog/rss.xml 404s (2026-10-05) and /blog advertises no feed (client-rendered) - browser-only, not dead. -->
      <!-- Feed URLs in this group are advertised by each site but were not byte-verified this run;
           confirm on first use and correct here rather than dropping. -->
    </outline>
    <outline text="English blogs (added 2026-09-07)">
      <outline type="rss" text="tapoueh.org (Dimitri Fontaine)" xmlUrl="https://tapoueh.org/index.xml"/>
      <outline type="rss" text="boringsql.com (Radim Marek)" xmlUrl="https://boringsql.com/atom.xml"/>
      <outline type="rss" text="MariaDB Foundation blog" xmlUrl="https://mariadb.org/feed/"/>
      <!-- blogs.oracle.com/mysql replaces dev.mysql.com/blog-archive, dead since 2025-03. -->
      <outline type="rss" text="Oracle MySQL blog" xmlUrl="https://blogs.oracle.com/mysql/feed"/>
      <!-- Feed URLs above are advertised by each site but were NOT byte-verified this run
           (cross-origin fetch from the browser pane is CORS-blocked, and plain fetch needs
           provenance). Confirm on first use and correct here rather than dropping. -->
    </outline>
    <outline text="English blogs (added 2026-09-21)">
      <!-- All four discovered during the 2026-09-14 sweep; feed URLs follow each platform's
           standard scheme and are advertised by the site, but were not byte-verified this run.
           Confirm on first use and correct here rather than dropping. -->
      <!-- commandprompt.com: /blog/rss.xml 404s (2026-10-05); no feed exists - read /blog.md or the HTML index. -->
      <outline type="rss" text="vondra.me (Tomas Vondra, committer)" xmlUrl="https://vondra.me/index.xml"/>
      <outline type="rss" text="markwkm (Mark Wong) - TPC-E/DBT-5 benchmarks" xmlUrl="https://markwkm.blogspot.com/feeds/posts/default"/>
      <outline type="link" text="Snowflake engineering - Open Source (ex-Crunchy PG writing)" htmlUrl="https://www.snowflake.com/en/blog/engineering/"/>
    </outline>
    <outline text="Russian [ru]">
      <outline type="rss" text="Habr - PostgreSQL hub [ok]" xmlUrl="https://habr.com/ru/rss/hubs/postgresql/articles/?fl=ru"/>
    </outline>
    <outline text="Japanese [ja]">
      <outline type="rss" text="Qiita - PostgreSQL tag [ok]" xmlUrl="https://qiita.com/tags/postgresql/feed"/>
    </outline>
    <outline text="French [fr]">
      <outline type="rss" text="Dalibo blog [ok]" xmlUrl="https://blog.dalibo.com/feed.xml"/>
    </outline>
    <outline text="German [de]">
      <!-- RETIRED 2026-09-07: Cybertec's German blog no longer exists (/de/ redirects to /en/,
           /de/postgresql-blog-de/ and /de/category/blog-de/ both 404). credativ.de/blog likewise
           redirects to /en/blog/ - the German edition is gone and the English one is stale.
           REPLACED 2026-09-14: heise online's database topic pages are server-rendered and dated,
           and are the first live [de] outlet this list has had. Feed URLs below follow heise's
           documented /rss/ scheme but were NOT byte-verified - the topic HTML pages enumerate
           fine with a plain fetch, so fall back to those if a feed 404s. -->
      <outline type="rss" text="heise - Datenbanken [unverified feed; HTML page enumerates fine]" xmlUrl="https://www.heise.de/thema/Datenbanken/rss.xml"/>
      <outline type="link" text="heise - PostgreSQL topic page [ok - plain fetch, dated]" htmlUrl="https://www.heise.de/thema/PostgreSQL"/>
    </outline>
    <outline text="Japanese [ja] (added 2026-09-07)">
      <!-- Monthly pgsql-hackers digest by a Postgres contributor; highest-value [ja] source.
           Feed URL unverified this run - confirm on first use. -->
      <!-- 2026-09-14: the category URL in sources.md (/tech-blog/postgresql-development-trends/)
           404s; the posts live under the PostgreSQL開発動向 category on /tech-blog/. Monthly,
           lands ~4th-7th, so it normally falls in the FIRST week's digest of a month. -->
      <outline type="rss" text="SRA OSS tech blog (pgsql-hackers watch)" xmlUrl="https://www.sraoss.co.jp/tech-blog/feed/"/>
      <!-- 2026-09-21: Publickey's Atom feed found; the HTML index fetches fine but the feed is
           cheaper and carries clean dates. Publickey was the only [ja] outlet with real DBMS
           news in the 09-14 week. -->
      <outline type="rss" text="Publickey (Junichi Niino)" xmlUrl="https://www.publickey1.jp/atom.xml"/>
    </outline>
    <outline text="Chinese [zh] - browser-rendered; no clean RSS, heavy vendor-PR (filter hard)">
      <!-- Browser-confirmed 2026-06-20: modb.pro renders fine via Claude-in-Chrome.
           cn.pingcap.com never reaches document_idle (long-polling) - get_page_text times out;
           use read_page (screenshot) or modb instead. Chinese DB media is dense vendor PR
           (Dameng, Kingbase, GoldenDB, Highgo, ...) - drop it; mine OceanBase/TiDB/PolarDB
           research and genuine internals posts. -->
      <!-- modb.pro RETIRED 2026-09-14 after a third failed enumeration: the page loads but every
           listing view is a client-rendered shell with no extractable dated article list, even in a
           real browser. Do not re-add without a working enumeration path. -->
      <!-- 2026-09-21: correction - pingkai.cn does NOT plain-fetch; it returns an empty body.
           Browser only. tidb.net still redirects here. -->
      <outline type="link" text="TiDB community blog [browser only - plain fetch returns empty]" htmlUrl="https://pingkai.cn/tidbcommunity/blog"/>
      <!-- 2026-09-21: working RSS found for the highest-yield zh source; fetches cold as clean
           XML with full dates, much cheaper than scraping the HTML index. -->
      <outline type="rss" text="老冯云数 / Ruohang Feng - highest-yield zh source [ok - cold XML]" xmlUrl="https://blog.vonng.com/index.xml"/>
      <outline type="link" text="PingCAP/TiDB CN blog [browser - slow; use read_page]" htmlUrl="https://cn.pingcap.com/blog/"/>
    </outline>
    <outline text="English blogs (added 2026-10-05 - feed reconciliation; [ok] unless noted)">
      <outline type="rss" text="PlanetScale blog" xmlUrl="https://planetscale.com/blog/feed.atom" htmlUrl="https://planetscale.com/blog"/>
